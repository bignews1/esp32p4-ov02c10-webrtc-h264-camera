# Applied AFTER board manager defaults. ESP32-P4 Function EV Board + OV02C10.
# Earlier rev 1.x board used by this project. Rev 3.x needs a separate profile
# with matching codec binaries; changing only the minimum revision is not enough.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_CAMERA_SC2336=n
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920x1080_2LAN_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
CONFIG_ESP_CAPTURE_ENABLE_VIDEO_DECODER=n
CONFIG_DOORBELL_SUPPORT_PEDESTRIAN_DETECT=n
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_EXAMPLE_WIFI_SSID=""
CONFIG_EXAMPLE_WIFI_PASSWORD=""
